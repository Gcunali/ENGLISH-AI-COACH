      "stageId": "theory",
      "stageType": "theory",
      "stageSchemaVersion": 1,
      "title": "Understand the language",
      "instructions": "Read the explanation, examples, common error, and recap.",
      "required": true,
      "payload": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "A complete introduction has a clear sequence. Start with a greeting. Give your name and ask for the other person's name. Add one or two useful details, such as country, city, language, or role. Listen to the answers and respond politely. If another person joins, use This is my classmate or This is my coworker. Close with Nice to meet you, See you, or Goodbye. This mission reviews the Unit; it adds no new major grammar."
          },
          {
            "type": "callout",
            "title": "Pattern",
            "text": "greeting → name → question → personal detail → polite response → goodbye"
          },
          {
            "type": "example",
            "english": "Hello, my name is Taylor.",
            "explanation": "This complete model prepares the learner to say: Hello, my name is Taylor."
          },
          {
            "type": "example",
            "english": "Nice to meet you, Taylor.",
            "explanation": "This complete model prepares the learner to say: Nice to meet you, Taylor."
          },
          {
            "type": "example",
            "english": "Where are you from?",
            "explanation": "This complete model prepares the learner to say: Where are you from?"
          },
          {
            "type": "paragraph",
            "text": "The practical goal is to complete a first meeting by greeting, exchanging names and origins, and closing politely. Use the pattern in a short exchange, notice the other speaker's words, and answer with one clear idea. The examples below prepare the same language used in listening, pronunciation practice, exercises, and the final conversation."
          },
          {
            "type": "callout",
            "title": "Common error",
            "text": "Do not ask every personal question immediately. Choose details that fit the situation and keep private contact information optional."
          },
          {
            "type": "bullet_list",
            "items": [
              "Choose the expression that fits the person and situation.",
              "Remember the core pattern: greeting → name → question → personal detail → polite response → goodbye.",
              "Answer clearly, then invite the other person to continue."
            ]
          }
        ]
      }
