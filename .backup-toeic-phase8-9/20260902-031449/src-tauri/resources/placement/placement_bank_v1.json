    {"id":"vocabulary-b1-1","skill":"vocabulary","cefrBand":"B1","prompt":"The meeting was ___ because the manager was ill.","options":[{"id":"a","text":"put off"},{"id":"b","text":"looked after"},{"id":"c","text":"given away"}],"correctOptionId":"a"},
