    {"id":"vocabulary-c1-1","skill":"vocabulary","cefrBand":"C1","prompt":"The rules are intended to ___ dishonest behavior.","options":[{"id":"a","text":"deter"},{"id":"b","text":"defer"},{"id":"c","text":"derive"}],"correctOptionId":"a"},
    {"id":"vocabulary-c1-2","skill":"vocabulary","cefrBand":"C1","prompt":"A “nuanced” argument ___.","options":[{"id":"a","text":"recognizes subtle distinctions"},{"id":"b","text":"uses only technical vocabulary"},{"id":"c","text":"avoids taking any position"}],"correctOptionId":"a"},
    {"id":"vocabulary-c1-3","skill":"vocabulary","cefrBand":"C1","prompt":"The two accounts are difficult to ___ because they contradict each other.","options":[{"id":"a","text":"reconcile"},{"id":"b","text":"rehearse"},{"id":"c","text":"reimburse"}],"correctOptionId":"a"},
