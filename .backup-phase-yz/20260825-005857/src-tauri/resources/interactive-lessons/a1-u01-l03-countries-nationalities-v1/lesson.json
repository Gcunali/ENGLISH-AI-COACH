    {
      "stageId": "theory",
      "stageType": "theory",
      "stageSchemaVersion": 1,
      "title": "Understand the language",
      "instructions": "Read the explanation, examples, common error, and recap.",
      "required": true,
      "payload": {
        "blocks": [
          {
            "type": "paragraph",
            "text": "Use be from plus a country to talk about origin: I'm from Brazil. Use be plus a nationality adjective to describe nationality: I'm Brazilian. A country and a nationality are related, but the words can be different. Ask Where are you from? to learn a person's country. Ask What language do you speak? when you want to know about language. Country, nationality, and language are separate ideas."
          },
          {
            "type": "callout",
            "title": "Pattern",
            "text": "Subject + be + from + country; Subject + be + nationality adjective"
          },
          {
            "type": "example",
            "english": "Where are you from?",
            "explanation": "This complete model prepares the learner to say: Where are you from?"
          },
          {
            "type": "example",
            "english": "I'm from Brazil.",
            "explanation": "This complete model prepares the learner to say: I'm from Brazil."
          },
          {
            "type": "example",
            "english": "I'm Brazilian.",
            "explanation": "This complete model prepares the learner to say: I'm Brazilian."
          },
          {
            "type": "paragraph",
            "text": "The practical goal is to say where you are from, state your nationality, and ask another person about origin. Use the pattern in a short exchange, notice the other speaker's words, and answer with one clear idea. The examples below prepare the same language used in listening, pronunciation practice, exercises, and the final conversation."
          },
          {
            "type": "callout",
            "title": "Common error",
            "text": "Do not say I am from Brazilian. After from, use the country Brazil. Without from, use the adjective Brazilian."
          },
          {
            "type": "bullet_list",
            "items": [
              "Choose the expression that fits the person and situation.",
              "Remember the core pattern: Subject + be + from + country; Subject + be + nationality adjective.",
              "Answer clearly, then invite the other person to continue."
            ]
          }
        ]
      }
