{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-ai-coach.local/schemas/interactive-lesson-package-v1.json",
  "title":"English AI Coach Interactive Lesson Package v1",
  "type":"object",
  "additionalProperties":false,
  "required":["packageSchemaVersion","lessonFlowVersion","lessonId","contentVersion","publicationState","title","description","language","referenceLocale","cefrBand","estimatedMinutes","objectives","tags","stages","assets"],
  "properties":{
    "packageSchemaVersion":{"const":1},"lessonFlowVersion":{"const":1},"lessonId":{"$ref":"#/$defs/slug"},"contentVersion":{"type":"integer","minimum":1},"publicationState":{"enum":["draft","published"]},"title":{"type":"string","minLength":1,"maxLength":100},"description":{"type":"string","minLength":1,"maxLength":500},"language":{"const":"en"},"referenceLocale":{"const":"en-US"},"cefrBand":{"enum":["A1","A2","B1","B2","C1","C2"]},"estimatedMinutes":{"type":"integer","minimum":1,"maximum":480},"objectives":{"type":"array","maxItems":5,"items":{"type":"string","minLength":1,"maxLength":180}},"tags":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":50}},"stages":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/stage"}},"assets":{"type":"array","items":{"$ref":"#/$defs/asset"}}
  },
  "$defs":{
    "slug":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","maxLength":100},
    "baseStage":{"type":"object","required":["stageId","stageType","stageSchemaVersion","title","instructions","required","payload"],"properties":{"stageId":{"$ref":"#/$defs/slug"},"stageType":{"enum":["theory","visual_vocabulary","listening","repeat","speaking_check","exercise","guided_conversation","analysis"]},"stageSchemaVersion":{"const":1},"title":{"type":"string","minLength":1,"maxLength":100},"instructions":{"type":"string","minLength":1,"maxLength":500},"required":{"type":"boolean"}}},
    "stage":{"allOf":[{"$ref":"#/$defs/baseStage"},{"oneOf":[
      {"properties":{"stageType":{"const":"listening"},"payload":{"$ref":"#/$defs/listeningPayload"}}},
      {"properties":{"stageType":{"const":"repeat"},"payload":{"$ref":"#/$defs/repeatPayload"}}},
      {"properties":{"stageType":{"const":"speaking_check"},"payload":{"$ref":"#/$defs/speakingPayload"}}},
      {"properties":{"stageType":{"enum":["theory","visual_vocabulary"]},"payload":{"type":"object"}}},
      {"properties":{"stageType":{"enum":["exercise","guided_conversation","analysis"]},"payload":{"type":"object","maxProperties":0}}}
    ]}],"unevaluatedProperties":false},
    "listeningPayload":{"type":"object","additionalProperties":false,"required":["segments","revealTextAfterFirstPlay"],"properties":{"revealTextAfterFirstPlay":{"type":"boolean"},"segments":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["segmentId","text","audioAssetId"],"properties":{"segmentId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":240},"audioAssetId":{"anyOf":[{"$ref":"#/$defs/slug"},{"type":"null"}]}}}}}},
    "repeatPayload":{"type":"object","additionalProperties":false,"required":["targets"],"properties":{"targets":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["targetId","text","referenceAudioAssetId","hint"],"properties":{"targetId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":160},"referenceAudioAssetId":{"anyOf":[{"$ref":"#/$defs/slug"},{"type":"null"}]},"hint":{"type":["string","null"],"maxLength":300}}}}}},
    "speakingPayload":{"type":"object","additionalProperties":false,"required":["targets"],"properties":{"targets":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["targetId","instruction","targetText","hint"],"properties":{"targetId":{"$ref":"#/$defs/slug"},"instruction":{"type":"string","minLength":1,"maxLength":300},"targetText":{"type":"string","minLength":1,"maxLength":160},"hint":{"type":["string","null"],"maxLength":300}}}}}},
    "asset":{"type":"object","additionalProperties":false,"required":["assetId","type","path","sha256"],"properties":{"assetId":{"$ref":"#/$defs/slug"},"type":{"enum":["image","audio"]},"path":{"type":"string","pattern":"^assets/[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}
  }
}
