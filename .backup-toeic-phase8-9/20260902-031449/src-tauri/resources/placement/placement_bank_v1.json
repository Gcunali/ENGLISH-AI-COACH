    {"id":"grammar-c2-2","skill":"grammar","cefrBand":"C2","prompt":"The report recommends that the policy be retained, ___ minor revisions.","options":[{"id":"a","text":"notwithstanding"},{"id":"b","text":"whereas"},{"id":"c","text":"lest"}],"correctOptionId":"a"},
