    {"id":"reading-a2-1","skill":"reading","cefrBand":"A2","passageId":"reading-a2","prompt":"Why will the library close early?","options":[{"id":"a","text":"The staff have training"},{"id":"b","text":"It is moving"},{"id":"c","text":"The computers are broken"}],"correctOptionId":"a"},
    {"id":"reading-a2-2","skill":"reading","cefrBand":"A2","passageId":"reading-a2","prompt":"When can Friday's books be returned without a fine?","options":[{"id":"a","text":"Saturday"},{"id":"b","text":"Thursday"},{"id":"c","text":"Monday only"}],"correctOptionId":"a"},
    {"id":"reading-a2-3","skill":"reading","cefrBand":"A2","passageId":"reading-a2","prompt":"What will still be available on Friday?","options":[{"id":"a","text":"The online catalogue"},{"id":"b","text":"Staff assistance"},{"id":"c","text":"The reading room"}],"correctOptionId":"a"},
    {"id":"reading-b1-1","skill":"reading","cefrBand":"B1","passageId":"reading-b1","prompt":"Why did Leo move?","options":[{"id":"a","text":"To reduce his commute"},{"id":"b","text":"To find cheaper shops"},{"id":"c","text":"To live near a park"}],"correctOptionId":"a"},
    {"id":"reading-b1-2","skill":"reading","cefrBand":"B1","passageId":"reading-b1","prompt":"What unexpected problem did he find?","options":[{"id":"a","text":"Local shops cost more"},{"id":"b","text":"The commute became longer"},{"id":"c","text":"His office moved away"}],"correctOptionId":"a"},
    {"id":"reading-b1-3","skill":"reading","cefrBand":"B1","passageId":"reading-b1","prompt":"Why has his total spending fallen?","options":[{"id":"a","text":"He prepares most meals himself"},{"id":"b","text":"He earns more money"},{"id":"c","text":"He stopped traveling to work"}],"correctOptionId":"a"},
    {"id":"reading-b2-1","skill":"reading","cefrBand":"B2","passageId":"reading-b2","prompt":"Where are shared bicycles used most?","options":[{"id":"a","text":"Near train stations"},{"id":"b","text":"In outer districts"},{"id":"c","text":"Beside schools only"}],"correctOptionId":"a"},
    {"id":"reading-b2-2","skill":"reading","cefrBand":"B2","passageId":"reading-b2","prompt":"What do officials consider most important for changing habits?","options":[{"id":"a","text":"Safer cycle lanes"},{"id":"b","text":"Lower train fares"},{"id":"c","text":"More parking spaces"}],"correctOptionId":"a"},
    {"id":"reading-b2-3","skill":"reading","cefrBand":"B2","passageId":"reading-b2","prompt":"What limitation do the early figures reveal?","options":[{"id":"a","text":"Use is uneven across the city"},{"id":"b","text":"All bicycles are used at night"},{"id":"c","text":"Car journeys have already ended"}],"correctOptionId":"a"},
    {"id":"reading-c1-1","skill":"reading","cefrBand":"C1","passageId":"reading-c1","prompt":"What benefit do employees often value?","options":[{"id":"a","text":"Autonomy"},{"id":"b","text":"Longer meetings"},{"id":"c","text":"Formal supervision"}],"correctOptionId":"a"},
    {"id":"reading-c1-2","skill":"reading","cefrBand":"C1","passageId":"reading-c1","prompt":"What has reportedly become harder?","options":[{"id":"a","text":"Informal learning"},{"id":"b","text":"Using technology"},{"id":"c","text":"Measuring commute time"}],"correctOptionId":"a"},
    {"id":"reading-c1-3","skill":"reading","cefrBand":"C1","passageId":"reading-c1","prompt":"What is the author's main conclusion?","options":[{"id":"a","text":"Work routines should combine flexibility with collaboration"},{"id":"b","text":"Everyone should return to the office"},{"id":"c","text":"Remote work always improves learning"}],"correctOptionId":"a"},
    {"id":"reading-c2-1","skill":"reading","cefrBand":"C2","passageId":"reading-c2","prompt":"What error do technology predictions often make?","options":[{"id":"a","text":"They equate prominence with importance"},{"id":"b","text":"They ignore all new inventions"},{"id":"c","text":"They focus only on ordinary habits"}],"correctOptionId":"a"},
    {"id":"reading-c2-2","skill":"reading","cefrBand":"C2","passageId":"reading-c2","prompt":"What may produce deeper social change?","options":[{"id":"a","text":"Gradual shifts in behavior"},{"id":"b","text":"Only dramatic inventions"},{"id":"c","text":"More confident predictions"}],"correctOptionId":"a"},
    {"id":"reading-c2-3","skill":"reading","cefrBand":"C2","passageId":"reading-c2","prompt":"What approach to forecasting does the author recommend?","options":[{"id":"a","text":"Consider behavior and avoid excessive certainty"},{"id":"b","text":"Stop forecasting completely"},{"id":"c","text":"Publish precise timelines first"}],"correctOptionId":"a"}
