    {"id":"vocabulary-a2-1","skill":"vocabulary","cefrBand":"A2","prompt":"If a bus is “crowded,” it has ___.","options":[{"id":"a","text":"many people"},{"id":"b","text":"no driver"},{"id":"c","text":"cheap tickets"}],"correctOptionId":"a"},
