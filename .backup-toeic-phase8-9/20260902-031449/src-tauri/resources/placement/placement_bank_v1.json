    {"id":"vocabulary-b2-2","skill":"vocabulary","cefrBand":"B2","prompt":"Her explanation was “plausible,” meaning it was ___.","options":[{"id":"a","text":"believable"},{"id":"b","text":"deliberately insulting"},{"id":"c","text":"impossible to hear"}],"correctOptionId":"a"},
