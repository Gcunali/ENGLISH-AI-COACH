    {"id":"vocabulary-a1-1","skill":"vocabulary","cefrBand":"A1","prompt":"Which word means the opposite of “hot”?","options":[{"id":"a","text":"cold"},{"id":"b","text":"new"},{"id":"c","text":"fast"}],"correctOptionId":"a"},
