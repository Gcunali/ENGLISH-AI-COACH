{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://english-ai-coach.local/schemas/interactive-lesson-package-v1.json",
  "title":"English AI Coach Interactive Lesson Package v1",
  "type":"object",
  "additionalProperties":false,
  "required":["packageSchemaVersion","lessonFlowVersion","lessonId","contentVersion","publicationState","title","description","language","referenceLocale","cefrBand","estimatedMinutes","objectives","tags","stages","assets"],
  "properties":{
    "packageSchemaVersion":{"const":1},"lessonFlowVersion":{"const":1},"lessonId":{"$ref":"#/$defs/slug"},"contentVersion":{"type":"integer","minimum":1},"publicationState":{"enum":["draft","published"]},"title":{"type":"string","minLength":1,"maxLength":100},"description":{"type":"string","minLength":1,"maxLength":500},"language":{"const":"en"},"referenceLocale":{"const":"en-US"},"cefrBand":{"enum":["A1","A2","B1","B2","C1","C2"]},"estimatedMinutes":{"type":"integer","minimum":1,"maximum":480},"objectives":{"type":"array","maxItems":5,"items":{"type":"string","minLength":1,"maxLength":180}},"tags":{"type":"array","maxItems":8,"items":{"type":"string","minLength":1,"maxLength":50}},"stages":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/stage"}},"assets":{"type":"array","items":{"$ref":"#/$defs/asset"}}
  },
  "$defs":{
    "slug":{"type":"string","pattern":"^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$","maxLength":100},
    "baseStage":{"type":"object","required":["stageId","stageType","stageSchemaVersion","title","instructions","required","payload"],"properties":{"stageId":{"$ref":"#/$defs/slug"},"stageType":{"enum":["theory","visual_vocabulary","listening","repeat","speaking_check","exercise","guided_conversation","analysis"]},"stageSchemaVersion":{"const":1},"title":{"type":"string","minLength":1,"maxLength":100},"instructions":{"type":"string","minLength":1,"maxLength":500},"required":{"type":"boolean"}}},
    "stage":{"allOf":[{"$ref":"#/$defs/baseStage"},{"oneOf":[
      {"properties":{"stageType":{"const":"listening"},"payload":{"$ref":"#/$defs/listeningPayload"}}},
      {"properties":{"stageType":{"const":"repeat"},"payload":{"$ref":"#/$defs/repeatPayload"}}},
      {"properties":{"stageType":{"const":"speaking_check"},"payload":{"$ref":"#/$defs/speakingPayload"}}},
      {"properties":{"stageType":{"const":"exercise"},"payload":{"$ref":"#/$defs/exercisePayload"}}},
      {"properties":{"stageType":{"enum":["theory","visual_vocabulary"]},"payload":{"type":"object"}}},
      {"properties":{"stageType":{"enum":["guided_conversation","analysis"]},"payload":{"type":"object","maxProperties":0}}}
    ]}],"unevaluatedProperties":false},
    "listeningPayload":{"type":"object","additionalProperties":false,"required":["segments","revealTextAfterFirstPlay"],"properties":{"revealTextAfterFirstPlay":{"type":"boolean"},"segments":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["segmentId","text","audioAssetId"],"properties":{"segmentId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":240},"audioAssetId":{"anyOf":[{"$ref":"#/$defs/slug"},{"type":"null"}]}}}}}},
    "repeatPayload":{"type":"object","additionalProperties":false,"required":["targets"],"properties":{"targets":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["targetId","text","referenceAudioAssetId","hint"],"properties":{"targetId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":160},"referenceAudioAssetId":{"anyOf":[{"$ref":"#/$defs/slug"},{"type":"null"}]},"hint":{"type":["string","null"],"maxLength":300}}}}}},
    "speakingPayload":{"type":"object","additionalProperties":false,"required":["targets"],"properties":{"targets":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"object","additionalProperties":false,"required":["targetId","instruction","targetText","hint"],"properties":{"targetId":{"$ref":"#/$defs/slug"},"instruction":{"type":"string","minLength":1,"maxLength":300},"targetText":{"type":"string","minLength":1,"maxLength":160},"hint":{"type":["string","null"],"maxLength":300}}}}}},
    "exercisePayload":{"type":"object","additionalProperties":false,"required":["items"],"properties":{"items":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/exerciseItem"}}}},
    "exerciseItem":{"type":"object","additionalProperties":false,"required":["exerciseId","exerciseType","prompt","instructions","hint","payload","feedback"],"properties":{"exerciseId":{"$ref":"#/$defs/slug"},"exerciseType":{"enum":["single_choice","multiple_select","fill_blank","word_order","matching","short_answer_exact"]},"prompt":{"type":"string","minLength":1,"maxLength":500},"instructions":{"type":["string","null"],"maxLength":300},"hint":{"type":["string","null"],"maxLength":300},"feedback":{"$ref":"#/$defs/exerciseFeedback"},"payload":{"type":"object"}},"allOf":[{"if":{"properties":{"exerciseType":{"const":"single_choice"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/singleChoicePayload"}}}},{"if":{"properties":{"exerciseType":{"const":"multiple_select"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/multipleSelectPayload"}}}},{"if":{"properties":{"exerciseType":{"const":"fill_blank"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/fillBlankPayload"}}}},{"if":{"properties":{"exerciseType":{"const":"word_order"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/wordOrderPayload"}}}},{"if":{"properties":{"exerciseType":{"const":"matching"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/matchingPayload"}}}},{"if":{"properties":{"exerciseType":{"const":"short_answer_exact"}}},"then":{"properties":{"payload":{"$ref":"#/$defs/shortAnswerPayload"}}}}]},
    "exerciseFeedback":{"type":"object","additionalProperties":false,"required":["correct","incorrect","explanation"],"properties":{"correct":{"type":"string","minLength":1,"maxLength":600},"incorrect":{"type":"string","minLength":1,"maxLength":600},"explanation":{"type":["string","null"],"maxLength":600}}},
    "exerciseOption":{"type":"object","additionalProperties":false,"required":["optionId","text"],"properties":{"optionId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":240}}},
    "exerciseToken":{"type":"object","additionalProperties":false,"required":["tokenId","text"],"properties":{"tokenId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":240}}},
    "matchingItem":{"type":"object","additionalProperties":false,"required":["itemId","text"],"properties":{"itemId":{"$ref":"#/$defs/slug"},"text":{"type":"string","minLength":1,"maxLength":240}}},
    "matchingPair":{"type":"object","additionalProperties":false,"required":["leftId","rightId"],"properties":{"leftId":{"$ref":"#/$defs/slug"},"rightId":{"$ref":"#/$defs/slug"}}},
    "singleChoicePayload":{"type":"object","additionalProperties":false,"required":["options","correctOptionId"],"properties":{"options":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/exerciseOption"}},"correctOptionId":{"$ref":"#/$defs/slug"}}},
    "multipleSelectPayload":{"type":"object","additionalProperties":false,"required":["options","correctOptionIds"],"properties":{"options":{"type":"array","minItems":2,"maxItems":10,"items":{"$ref":"#/$defs/exerciseOption"}},"correctOptionIds":{"type":"array","minItems":1,"maxItems":10,"uniqueItems":true,"items":{"$ref":"#/$defs/slug"}}}},
    "fillBlankPayload":{"type":"object","additionalProperties":false,"required":["prefix","suffix","acceptedAnswers","normalizationProfile"],"properties":{"prefix":{"type":"string","maxLength":500},"suffix":{"type":"string","maxLength":500},"acceptedAnswers":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"normalizationProfile":{"const":"english_basic_v1"}}},
    "wordOrderPayload":{"type":"object","additionalProperties":false,"required":["tokens","correctOrder"],"properties":{"tokens":{"type":"array","minItems":2,"maxItems":20,"items":{"$ref":"#/$defs/exerciseToken"}},"correctOrder":{"type":"array","minItems":2,"maxItems":20,"uniqueItems":true,"items":{"$ref":"#/$defs/slug"}}}},
    "matchingPayload":{"type":"object","additionalProperties":false,"required":["leftItems","rightItems","correctPairs"],"properties":{"leftItems":{"type":"array","minItems":2,"maxItems":10,"items":{"$ref":"#/$defs/matchingItem"}},"rightItems":{"type":"array","minItems":2,"maxItems":10,"items":{"$ref":"#/$defs/matchingItem"}},"correctPairs":{"type":"array","minItems":2,"maxItems":10,"items":{"$ref":"#/$defs/matchingPair"}}}},
    "shortAnswerPayload":{"type":"object","additionalProperties":false,"required":["acceptedAnswers","normalizationProfile"],"properties":{"acceptedAnswers":{"type":"array","minItems":1,"maxItems":12,"uniqueItems":true,"items":{"type":"string","minLength":1,"maxLength":200}},"normalizationProfile":{"const":"english_basic_v1"}}},
    "asset":{"type":"object","additionalProperties":false,"required":["assetId","type","path","sha256"],"properties":{"assetId":{"$ref":"#/$defs/slug"},"type":{"enum":["image","audio"]},"path":{"type":"string","pattern":"^assets/[A-Za-z0-9._/-]+$"},"sha256":{"type":"string","pattern":"^[A-Fa-f0-9]{64}$"}}}
  }
}
